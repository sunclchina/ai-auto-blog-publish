# ============================================================================
# A-Blog 密钥文件模板 → 部署时由 install.sh 复制为 backend/.env 并 chmod 600
# 用途: systemd 通过 EnvironmentFile=/opt/ablog/backend/.env 注入进程环境,
#       config.py 按 ABP_* 变量名读取 (优先级: 环境变量 > config.yaml)。
# 安全: 本文件仅 root/ablog 可读; 严禁提交 git / 写入日志 / 出现在 crontab 命令行。
# 说明: 必填项缺失时 config.py 拒绝启动; 可选项留空 = 该能力关闭(如纯文字发布)。
# 修改后: sudo systemctl restart ablog
# ============================================================================

# ---- 必填 ----
# DeepSeek API Key (models.provider=deepseek 时必填)
ABP_DEEPSEEK_KEY=

# WordPress 插件「AI 自动博客」设置页生成的 API Token (发布必填)
ABP_WP_TOKEN=

# ---- 可选 ----
# 豆包 API Key (models.provider=volc 时必填)
ABP_VOLC_KEY=

# 通义 API Key (models.provider=qwen 时必填)
ABP_QWEN_KEY=

# 生图服务 Key (未配置则纯文字发布)
ABP_IMAGE_KEY=
